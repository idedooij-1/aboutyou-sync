# AboutYou Seller Center API key
# Generate at: partner.aboutyou.com > Settings > API Keys
ABOUTYOU_API_KEY=

# Shopify store (myshopify.com domain)
SHOPIFY_SHOP_DOMAIN=54325e.myshopify.com

# Shopify custom app credentials (from dev.shopify.com/dashboard > Aboutyou > Settings)
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# Shopify Admin API access token — obtained by visiting /auth/install after first deploy
SHOPIFY_ACCESS_TOKEN=

# Public URL of this Railway app (needed for OAuth callback + AY image serving)
APP_URL=https://your-app.railway.app

# Used by images.js to build public URLs for AboutYou image listings.
# Set to the same value as APP_URL.
SERVER_URL=https://your-app.railway.app

# Shopify webhook secret — use your custom app's Client Secret
SHOPIFY_WEBHOOK_SECRET=your_client_secret_here

# Comma-separated AboutYou country codes to sync prices for
# Common options: DE, AT, NL, BE, PL, FR, CH
ABOUTYOU_COUNTRY_CODES=DE,NL

# Optional: protect /sync/* endpoints with a token
SYNC_TOKEN=change-me

# --- Product listing (Shopify → AboutYou) ---

# JSON map of Shopify vendor name → AboutYou brand ID (from Seller Center > Brands)
# Built-in: GUESS=174728, Jimmy Choo=176645, Max Mara=179312
# Add or override here:
ABOUTYOU_BRAND_MAP=
ABOUTYOU_DEFAULT_BRAND_ID=

# JSON map of Shopify product_type → AboutYou category ID
# Look up IDs via GET /api/v1/categories/?query=<name>
# e.g. {"Sunglasses":12345}
ABOUTYOU_CATEGORY_MAP=
ABOUTYOU_DEFAULT_CATEGORY_ID=

# JSON map of Shopify color option value → AboutYou color attribute ID
# Look up via GET /api/v1/categories/<category_id>/attribute-groups
# e.g. {"Black":1,"Brown":2,"Gold":3}
ABOUTYOU_COLOR_MAP=

# JSON map of Shopify size option value → AboutYou size attribute ID
ABOUTYOU_SIZE_MAP=

# Shopify option names for size and color (defaults: "Size" and "Color")
ABOUTYOU_SIZE_OPTION_NAME=Size
ABOUTYOU_COLOR_OPTION_NAME=Color

# Comma-separated language codes for product descriptions (default: "de,en")
ABOUTYOU_DESCRIPTION_LANG=de,en
